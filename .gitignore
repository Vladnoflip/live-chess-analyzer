# Dependencies
node_modules/

# Build output
dist/
dist-extension/
coverage/

# Stockfish WASM copied from node_modules at build time (npm run copy-engine)
public/engine/

# Local screenshots produced by the e2e run (docs/screenshots/ is committed)
e2e-screenshots/
smoke-lichess.png
# Packed builds and the packing key (never commit the private key)
*.crx
*.pem
dist-extension.zip

# Puppeteer / Chrome for Testing (~150 MB) and test browser profiles
.cache/
.local-chromium/
.local-browsers/
chrome/
chrome-headless-shell/
puppeteer-profile*/
.puppeteer*/

# Environment and secrets
.env
.env.*
!.env.example

# Logs and OS / editor files
*.log
# Recorded Stockfish output used as a test fixture
!tests/fixtures/*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code session settings
.claude/

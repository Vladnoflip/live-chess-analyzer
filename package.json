{
  "name": "livechess-analyzer",
  "version": "0.5.0",
  "private": true,
  "description": "Local chess analysis with Stockfish 18 WASM: MultiPV analyzer, 0-100 move scoring, openings explorer and trainer, and a Chrome MV3 extension that works only against bots and on analysis pages.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vladnoflip/live-chess-analyzer.git"
  },
  "homepage": "https://github.com/Vladnoflip/live-chess-analyzer#readme",
  "bugs": {
    "url": "https://github.com/Vladnoflip/live-chess-analyzer/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy-engine": "node scripts/copy-engine.mjs",
    "predev": "npm run copy-engine",
    "dev": "vite",
    "prebuild": "npm run copy-engine",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/**/*.integration.test.ts\"",
    "test:integration": "vitest run tests/engine.integration.test.ts",
    "build:extension": "npm run copy-engine && tsc --noEmit && vite build --config vite.config.extension.ts",
    "test:extension": "npm run build:extension && node scripts/verify-extension.mjs",
    "build-openings": "node scripts/build-openings.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "puppeteer": "^24.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
